{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vicky-agent-lab-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {"enabled": false},
  "vars": {
    "ALLOWED_ORIGIN": "https://lyx1265897416-lab.github.io",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "DAILY_CALL_LIMIT": "30",
    "PUBLIC_TRIAL": "true"
  },
  "durable_objects": {"bindings": [
    {"name": "BUDGET", "class_name": "TrialBudget"},
    {"name": "INTERVIEWS", "class_name": "InterviewSession"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["TrialBudget", "InterviewSession"]}]
}
