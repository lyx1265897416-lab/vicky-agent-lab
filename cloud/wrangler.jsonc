{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vicky-agent-lab-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "ALLOWED_ORIGIN": "https://lyx1265897416-lab.github.io",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "DAILY_CALL_LIMIT": "30",
    "PUBLIC_TRIAL": "false"
  },
  "durable_objects": {"bindings": [
    {"name": "BUDGET", "class_name": "TrialBudget"},
    {"name": "INTERVIEWS", "class_name": "InterviewSession"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["TrialBudget", "InterviewSession"]}]
}
